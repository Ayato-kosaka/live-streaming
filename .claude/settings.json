{
  "permissions": {
    "allow": [
      "Bash(aws --profile sandbox:*)",
      "Bash(bash .claude/skills/doneru-cookie/ec2_exec.sh:*)",
      "Bash(bash .claude/skills/doneru-cookie/wait_challenge.sh:*)",
      "Bash(cp /home/user/ayato-kosaka/nanitabeyo/.claude/skills/ec2-chrome-operate/ec2_exec.sh .claude/skills/doneru-cookie/:*)",
      "Write(.claude/skills/doneru-cookie/**)",
      "Edit(.claude/skills/doneru-cookie/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-old-domain.sh stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-clobber.sh"
          }
        ]
      },
      {
        "matcher": "PushNotification|mcp__github__add_issue_comment|mcp__github__update_issue_comment|mcp__github__issue_write|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__add_reply_to_pull_request_comment|mcp__github__pull_request_review_write|mcp__claude-code-remote__send_message|SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-old-domain.sh pre"
          }
        ]
      }
    ]
  }
}
