# fetch_chat_data.py
/tmp/youtube_chat
# あやと島(Next.js)のビルド成果物
site/out/
site/.next/

# `.next` は site/ 以外にも出る。直下で `next` を回すと turbopack の cache が
# リポジトリ直下に落ち、`tools/sprites/` でも trace が落ちる。site/ ぶんしか
# 書いていなかったので、直下の22本と tools/sprites の2本が**追跡されたまま**
# 残っていた（worktree を切ってビルドを回すたび差分に出ていた）。
# どこに出ても拾えるよう、場所を固定せず名前だけで無視する。
#
# **`.next-*` は書かない。** `tools/build.sh` が `NEXT_DIST_DIR=.next-<ポート>` で
# 担当ごとに書き出し先を分けており（`site/.next-3130` など）、末尾に付く名前まで
# 巻き込むと、焼いたものが git から見えなくなる。ここが拾うのは `.next` ちょうどだけ
.next/

# 島のスプライトの元素材とライブラリ（tools/sprites/README.md の手順で取得する）
tools/sprites/models/
tools/sprites/vendor/
tools/sprites/node_modules

# 性能を測った記録。手元の比較用なので持ち回らない
tools/sprites/.perf/

# 使い捨ての測定スクリプト。並列で作業していると溜まるので、追わない。
# **持ち回る道具に `_` を付けない。** ここに当たると git に入らないので、
# クローンしたところでは「その不具合の確かめかた」ごと消える
# （`_read.mjs` が実際にそうなっていた。いまは `readbase.mjs`）
tools/sprites/_*

# ビルドを1本ずつ回すための錠
.buildlock

# 並列で動かした担当の作業場（git worktree）。中身は各ブランチにある
.claude/worktrees/

# OpenStreetMap の生データ（数十MB。tools/nordic/osmfetch.py が落とす）
tools/nordic/.osmcache/

# キャラクターの絵と名前の受け渡し場所（python/admin/characters_add.py）。
# **誰の絵が誰のものかは公開リポジトリに残さない。** 流すときだけ枝に
# `git add -f` で載せて、済んだら枝ごと落とす。
python/admin/_incoming/

# 切り抜きの mp4 を作るとき、yt-dlp が n challenge を解くのに deno を使う。
# リポジトリ直下で走らせると置き土産が出るが、これは道具の作業ファイルで
# 中身に意味は無い。毎回コミットを求められるので無視する。
deno.lock

# 配ってある先の道（セッションごとの覚え書き。`/hand-off` と stop hook が使う）
.claude/.handoff
