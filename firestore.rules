rules_version = '2';

/**
 * Firestore セキュリティルール。
 *
 * 方針:
 *   - 既存の月末配信ページ(OBSとスマホコントローラの同期)は今まで通り動かす
 *   - あやと島のデータはブラウザから直接触らせない。書き込みも読み取りも
 *     Cloud Functions(islandApi)経由にする。Admin SDK はルールを迂回するので、
 *     ここでは全部 deny にしておけばよい
 *   - 明示していないものは全部 deny
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // 月末配信の進行同期。合言葉つきのドキュメントIDを知っている人だけが使う想定。
    match /monthlyReview/{docId} {
      allow read, write: if true;
    }

    /* いま島にいる人(docs/island-here.md)。
       **ここだけはブラウザから直接読み書きする。**
       他の人の動きを「動いて見える」速さで出すには、数秒ごとに Function へ
       聞きにいくのでは足りない。onSnapshot で受けたいので、ここだけ開ける。

       開けても危なくない形にしてある。
         - **名前とアイコンを入れさせない。** 入れさせると他人の名前を名乗れる。
           入るのは居場所と時刻だけで、誰なのかは islandApi が本人確認した
           residents(チャンネルと、本人が出してよいと言った名前・アイコン)と
           uid で突き合わせて、読む側が決める
         - **書けるのは自分のぶんだけ。** ドキュメントIDが uid と一致すること
         - **項目を4つに絞る。** 知らない項目を足せない
         - **seenAt はサーバー時刻でなければ通さない。** 手元の時計を書かせると、
           ずっと「オンライン」でいられる
         - **1秒に1回より速くは書かせない。** 書いた回数で課金されるので、
           ここを開けるのは財布を開けるのと同じでもある。ブラウザ側にも
           2秒しばりがあるが、あれは自分で外せる。速さを決めるのは、
           外せないほうに置く
       読むのは誰でも。ログインしていなくても、いる人が見える。 */
    match /islandHere/{uid} {
      /* 置いてよい形か。create と update で同じものを見るので、1つにまとめる。
         **exists() を使わない。** ルールの中から別のドキュメントを読むと、
         書くたびに読み1回ぶんの代金が乗る。create は「まだ無いとき」、
         update は「もうあるとき」に呼ばれると決まっているので、
         前の値が要る条件は update のほうにだけ書けばよい。 */
      function shape() {
        return request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["at", "x", "y", "seenAt"])
          && request.resource.data.seenAt == request.time
          && request.resource.data.at is string
          && request.resource.data.at.size() <= 60
          && request.resource.data.at.matches("^/[A-Za-z0-9/_-]*$")
          && request.resource.data.x is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1200
          && request.resource.data.y is number
          && request.resource.data.y >= 0 && request.resource.data.y <= 1200;
      }
      /** 前に置いてから1秒たったか。置き直しと、消すのに掛ける。 */
      function slow() {
        return request.time > resource.data.seenAt + duration.value(1, 's');
      }
      allow read: if true;
      allow create: if shape();
      allow update: if shape() && slow();
      /* 消すのも1秒に1回まで。ここを開けたままにすると、消して作り直すを
         繰り返して update の縛りをすり抜けられる。
         消せなかったぶんは、60秒たてば読む側が出さなくなる。 */
      allow delete: if request.auth != null && request.auth.uid == uid && slow();
    }

    // あやと島。ブラウザからは触らせない(islandApi 経由のみ)。
    match /island/{docId} { allow read, write: if false; }
    match /islandIdeas/{docId} { allow read, write: if false; }
    match /islandNotes/{docId} { allow read, write: if false; }
    /* 付箋のハート(#160)。1人1回を守るためだけの入れ物で、
       ドキュメントIDが `<付箋のID>_<端末IDか uid>`。
       **ここを開けると、誰が何を押したかが端末IDごと全部読める。**
       押した数は islandNotes 側に持っているので、読む用事もここには無い。 */
    match /islandHearts/{docId} { allow read, write: if false; }
    match /islandVotes/{docId} { allow read, write: if false; }
    match /islandRate/{docId} { allow read, write: if false; }
    match /islandUsers/{docId} { allow read, write: if false; }
    match /islandDrafts/{docId} { allow read, write: if false; }
    /* 企画(#161)。一言の提案とページ1枚の下書きを1つにした入れ物。
       **ここには端末ID(cid)が入っている。** それは「あとから自分の企画を
       直す鍵」なので、読めるようにすると誰でも他人の企画を直せる。
       画面が要るのは表に出す欄だけなので、islandApi に絞らせる。
       #202 で `islandStreamEvent` へ改名した。旧のほうも当分残す
       （移し終わるまで、両方に書類がある）。 */
    match /islandNextPlans/{docId} { allow read, write: if false; }
    match /islandStreamEvent/{docId} { allow read, write: if false; }

    /* 企画に付く画像(#202)。旧 nordicPhotos。
       貼れるのはあやとだけ、読むのは誰でもだが、**どちらも islandApi 経由**。
       ここを開けると、企画ごとの写真の一覧がまとめて引ける。
       画面が要るのは出す企画のぶんだけなので、Function に絞らせる。 */
    match /islandStreamEventImage/{docId} { allow read, write: if false; }

    /* 投げ銭の台帳(#202)。**ここは絶対に開けない。**
       誰がいくら出したかが1件ずつ入っている。**本人以外に見えてはいけない。**
       ドキュメントIDはハッシュなので当てられないが、collection ごと引ければ
       関係ない。読むのは Functions（Admin SDK はルールを迂回する）と
       日次ジョブだけ。

       島の画面に金額を出す口はどこにも無い。**金額で並べない・出さない**
       という決めは #202 でも生きている（`docs/nordic-fund.md`）。 */
    match /islandTips/{docId} { allow read, write: if false; }

    /* チャンネルIDと名前・プロフィール写真の辞書(#190・#202)。
       名前も写真も YouTube で公開されているものだが、**ここには
       配信に来た2,200人ぶんが並んでいる。** 「誰が来ているか」の
       名簿になるので、collection ごとは引かせない。 */
    match /islandChannels/{docId} { allow read, write: if false; }

    /* どねID と YouTube のアカウントの対応表(#190)。
       **どねID は Doneru の中の人の識別子。** 誰が Doneru で投げ銭して
       いるかがそのまま並ぶので、開けない。読み書きは islandApi 経由で
       あやとだけ。 */
    match /islandDonors/{docId} { allow read, write: if false; }

    /* 配信のルーレット(#164)。コントローラーと OBS を繋ぐ入れ物。
       **ここを開けない。** 表示側(OBS)はログインできないので読ませる道が
       要るが、それは islandApi の `GET /roulette/{id}` に絞る。ここを
       「読むのは誰でも」にすると、collection ごと引けるようになって、
       **推測できない id にした意味が無くなる**(1つ知られると全部読める)。
       書くほうは、当たりをサーバーで決める仕掛けそのものなので開けない。 */
    match /rouletteSessions/{docId} { allow read, write: if false; }

    /* 島の遠隔操作(#165)。コントローラー(あやとの手元)と、配信に映して
       いる島を繋ぐ入れ物。**ここを開けない。**
       表示側(OBS)はログインできないので読ませる道が要るが、それは
       islandApi の `GET /remote?sessionId=…` に絞る。ここを
       「読むのは誰でも」にすると collection ごと引けるようになって、
       **推測できない sessionId にした意味が無くなる**(1つ知られると全部読める)。
       書くほうは、押せるのがあやとだけという仕掛けそのものなので開けない。 */
    match /islandRemote/{docId} { allow read, write: if false; }

    /* あやと島カード(#173)。#202 で**配ってある**形になった。
       前は写真と名簿から読むたびに組み立てていて、ここに入るのは
       「本人が動かしたぶんの上書き」だけだった。いまは1枚1書類ある。

       それでも開けない。ドキュメントIDが `<画像のID>__<チャンネルID>` で、
       中にも `channelId` が入っているので、**collection ごと読めると
       「誰がどの日に投げ銭したか」が台帳を見ずに引ける。**
       islandApi の `GET /cards` は、名前を出してよいと言った人だけを通す。 */
    match /islandCards/{docId} { allow read, write: if false; }

    /* 北欧旅の、その日の写真とその日いた人(docs/nordic-photos.md)。
       貼れるのはあやとだけ、読むのは誰でもだが、**どちらも islandApi 経由**。
       ここを開けると「読むのは誰でも」を書きたくなるが、そうすると
       写真の置き場も、その日いた人の一覧も、まとめて引けるようになる。
       画面が要るのは「写真のある日ぶん」だけなので、Function に絞らせる。 */
    match /nordicPhotos/{docId} { allow read, write: if false; }
    match /nordicDays/{docId} { allow read, write: if false; }
    /* 旅の「その日に起きたこと」(docs/nordic-depart.md)。
       書けるのはあやとだけ、読むのは誰でもだが、**どちらも islandApi 経由**。
       ここを開けると、書けるのは誰かの判定もここに書くことになる。
       あやとかどうかを見るところを2つに増やさない。 */
    match /nordicLog/{docId} { allow read, write: if false; }

    // それ以外は禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
