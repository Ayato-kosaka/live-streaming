    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/nG_voice/out/p1/07.wav",
    "tts_text": "十二回乗ったら、もと取れる。",
    "at": 397
   },
   {
    "text": "街に出まくったる！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/nG_voice/out/p1/08.wav",
    "tts_text": "街に出まくったる！",
    "at": 460,
    "big": "glow_yellow",
    "caption_from": 450
   },
   {
