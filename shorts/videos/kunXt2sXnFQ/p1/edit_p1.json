    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/voice/kun-p1-v1/p1/14.wav",
    "tts_text": "また集まってきたから、投げるフリ！ほい！",
