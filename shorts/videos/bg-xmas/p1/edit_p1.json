    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/xms/voice/xms-p1-v1/p1/17.wav",
    "tts_text": "ワッフルを頼んだら、",
    "at": 1127
   },
   {
