    "parts": [
     {
      "text": "わお\n人がいっぱいいるよ。"
     }
    ],
    "orig_voice": true,
    "voice_src": true
   },
   {
    "text": "屋台を1軒ずつ見て回ったら、",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/xms/voice/xms-p1-v1/p1/13.wav",
    "tts_text": "屋台をいっけんずつ見て回ったら、",
    "at": 894
   },
   {
    "text": "ホットワインの小屋に、スノードーム屋さん！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/xms/voice/xms-p1-v1/p1/14.wav",
    "tts_text": "ホットワインの小屋に、スノードーム屋さん！",
    "at": 948
   },
   {
