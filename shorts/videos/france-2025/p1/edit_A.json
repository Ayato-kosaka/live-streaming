 "telops": [],
 "narration": {
  "engine": "files",
  "tempo": 1.4,
  "lines": [
   {
    "text": "フランスに行ったら、10日でモンサンミッシェルも南仏も回れた！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/01.wav",
    "tts_text": "フランスに行ったら、とおかでモンサンミッシェルも、なんふつも回れた！",
    "at": 0
   },
   {
    "text": "人生初の左ハンドル！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/02.wav",
    "tts_text": "人生初の左ハンドル！",
    "at": 117,
    "mood": "tense_tilt"
   },
   {
    "text": "まずルーアン。ジャンヌ・ダルクの教会で、観光終わりです！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/03.wav",
    "tts_text": "まずルーアン。ジャンヌダルクの教会で、観光終わりです！",
    "at": 169,
    "parts": [
     {
      "text": "まずルーアン。ジャンヌ・ダルクの教会で、"
     },
     {
      "text": "観光終わりです！",
      "big": "brush_zoom"
     }
    ]
   },
   {
    "text": "次、モンサンミッシェル。ほんまに海に浮いてた！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/04.wav",
    "tts_text": "次、モンサンミッシェル。ほんまに海に浮いてた！",
    "at": 272,
    "mood": "up_pop"
   },
   {
    "text": "満潮で、砂浜降りたら靴びちゃびちゃや！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/05.wav",
    "tts_text": "満潮で、砂浜おりたら靴びちゃびちゃや！",
    "at": 367,
    "parts": [
     {
      "text": "満潮で、砂浜降りたら"
     },
     {
      "text": "靴びちゃびちゃや！",
      "big": "shake_white"
     }
    ]
   },
   {
    "text": "残り6日は、飛行機で南仏。雲1個しかない、南国来てもうた！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/06.wav",
    "tts_text": "残りむいかは、飛行機でなんふつ。雲いっこしかない、なんごく来てもうた！",
    "at": 450,
    "mood": "up_pop"
   },
   {
    "text": "山の上に村がポンポン！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/07.wav",
    "tts_text": "山の上に村がポンポン！",
    "at": 591
   },
   {
    "text": "と思ったら次の街は暴風。お目当てのアンティーク市も休み。",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/08.wav",
    "tts_text": "と思ったら次の街は暴風。お目当てのアンティークいちも休み。",
    "at": 647,
    "mood": "tense_shake"
   },
   {
    "text": "老後の楽しみに、残しときました。",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/09.wav",
    "tts_text": "老後の楽しみに、残しときました。",
    "at": 754,
    "mood": "tense_still"
   },
   {
    "text": "次の日は晴れて、2000年近く前の橋。セメント無しで建ってる！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/10.wav",
    "tts_text": "次の日は晴れて、二千年近く前の橋。セメント無しで建ってる！",
    "at": 818,
    "mood": "up_pop",
    "highlight": [
     "2000年近く前"
    ]
   },
   {
    "text": "レンタカーでスペインの手前まで来た！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/11.wav",
    "tts_text": "レンタカーでスペインの手前まで来た！",
    "at": 934
   },
   {
    "text": "食べたんはパエリア。それスペインやないかい！",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/12.wav",
    "tts_text": "食べたんはパエリア。それスペインやないかい！",
    "at": 995,
    "parts": [
     {
      "text": "食べたんはパエリア。"
     },
     {
      "text": "それスペインやないかい！",
      "big": "shake_red"
     }
    ]
   },
   {
    "text": "みんなやったら、フランス10日、どこ回る？",
    "audio": "/tmp/claude-0/-home-user-live-streaming/7b54307b-9720-512c-9147-76f79b3cf92a/scratchpad/fr_a/voice/out/A/13.wav",
    "tts_text": "みんなやったら、フランスとおか、どこ回る？",
    "at": 1066
   }
  ]
 },
