{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next*/types/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next-3010/types/**/*.ts",
    ".next-dev3010/types/**/*.ts",
    ".next-3011/types/**/*.ts",
    ".next-dev3011/types/**/*.ts",
    ".next-3012/types/**/*.ts",
    ".next-dev3012/types/**/*.ts",
    ".next-3013/types/**/*.ts",
    ".next-dev3013/types/**/*.ts",
    ".next-3014/types/**/*.ts",
    ".next-dev3014/types/**/*.ts",
    ".next-3015/types/**/*.ts",
    ".next-dev3015/types/**/*.ts",
    ".next-3016/types/**/*.ts",
    ".next-dev3016/types/**/*.ts",
    ".next-3018/types/**/*.ts",
    ".next-dev3018/types/**/*.ts",
    ".next-3020/types/**/*.ts",
    ".next-dev3020/types/**/*.ts",
    ".next-3021/types/**/*.ts",
    ".next-dev3021/types/**/*.ts",
    ".next-3022/types/**/*.ts",
    ".next-dev3022/types/**/*.ts",
    ".next-3025/types/**/*.ts",
    ".next-dev3025/types/**/*.ts",
    ".next-3030/types/**/*.ts",
    ".next-dev3030/types/**/*.ts",
    ".next-3031/types/**/*.ts",
    ".next-dev3031/types/**/*.ts",
    ".next-3032/types/**/*.ts",
    ".next-dev3032/types/**/*.ts",
    ".next-3033/types/**/*.ts",
    ".next-dev3033/types/**/*.ts",
    ".next-3040/types/**/*.ts",
    ".next-dev3040/types/**/*.ts",
    ".next-3041/types/**/*.ts",
    ".next-dev3041/types/**/*.ts",
    ".next-3110/types/**/*.ts",
    ".next-dev3110/types/**/*.ts",
    ".next-3120/types/**/*.ts",
    ".next-dev3120/types/**/*.ts",
    ".next-3130/types/**/*.ts",
    ".next-dev3130/types/**/*.ts",
    ".next-3140/types/**/*.ts",
    ".next-dev3140/types/**/*.ts",
    ".next-3150/types/**/*.ts",
    ".next-dev3150/types/**/*.ts",
    ".next-3160/types/**/*.ts",
    ".next-dev3160/types/**/*.ts",
    ".next-3170/types/**/*.ts",
    ".next-dev3170/types/**/*.ts",
    ".next-3180/types/**/*.ts",
    ".next-dev3180/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-perf/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
