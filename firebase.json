{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/island/albania",
        "destination": "/island/balkans",
        "type": 301
      },
      {
        "source": "/island/albania/**",
        "destination": "/island/balkans",
        "type": 301
      },
      {
        "source": "/island/north-macedonia",
        "destination": "/travel/north-macedonia",
        "type": 301
      },
      {
        "source": "/island/north-macedonia/**",
        "destination": "/travel/north-macedonia",
        "type": 301
      },
      {
        "source": "/nordic/day/10",
        "destination": "/island/nordic#day-10",
        "type": 301
      },
      {
        "source": "/nordic/day/11",
        "destination": "/island/nordic#day-11",
        "type": 301
      },
      {
        "source": "/nordic/day/12",
        "destination": "/island/nordic#day-12",
        "type": 301
      },
      {
        "source": "/nordic/day/13",
        "destination": "/island/nordic#day-13",
        "type": 301
      },
      {
        "source": "/nordic/day/14",
        "destination": "/island/nordic#day-14",
        "type": 301
      },
      {
        "source": "/nordic/day/15",
        "destination": "/island/nordic#day-15",
        "type": 301
      },
      {
        "source": "/nordic/day/16",
        "destination": "/island/nordic#day-16",
        "type": 301
      },
      {
        "source": "/nordic_review.html",
        "destination": "/nordic/review",
        "type": 301
      },
      {
        "source": "/nordic_review",
        "destination": "/nordic/review",
        "type": 301
      },
      {
        "source": "/nordic/photos",
        "destination": "/cards",
        "type": 301
      },
      {
        "source": "/nordic/photos/**",
        "destination": "/cards",
        "type": 301
      },
      {
        "source": "/next/new",
        "destination": "/board",
        "type": 301
      },
      {
        "source": "/next/new/**",
        "destination": "/board",
        "type": 301
      },
      {
        "source": "/map",
        "destination": "/travel",
        "type": 301
      },
      {
        "source": "/map/:slug",
        "destination": "/travel/:slug",
        "type": 301
      },
      {
        "source": "/nordic/poland",
        "destination": "/travel/poland",
        "type": 301
      },
      {
        "source": "/nordic/lithuania",
        "destination": "/travel/lithuania",
        "type": 301
      },
      {
        "source": "/nordic/latvia",
        "destination": "/travel/latvia",
        "type": 301
      },
      {
        "source": "/nordic/estonia",
        "destination": "/travel/estonia",
        "type": 301
      },
      {
        "source": "/nordic/finland",
        "destination": "/travel/finland",
        "type": 301
      },
      {
        "source": "/nordic/sweden",
        "destination": "/travel/sweden",
        "type": 301
      },
      {
        "source": "/north-macedonia",
        "destination": "/travel/north-macedonia",
        "type": 301
      },
      {
        "source": "/atlas",
        "destination": "/island",
        "type": 301
      },
      {
        "source": "/nordic",
        "destination": "/island/nordic",
        "type": 301
      },
      {
        "source": "/nordic/day/:n",
        "destination": "/island/nordic/day/:n",
        "type": 301
      },
      {
        "source": "/nordic/guide",
        "destination": "/island/nordic/guide",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/island-api/**",
        "function": "islandApi"
      },
      {
        "source": "/nanitabeyo-weekly-report-proxy",
        "function": "nanitabeyoWeeklyReportProxy"
      },
      {
        "source": "/nanitabeyo-weekly-report-proxy/**",
        "function": "nanitabeyoWeeklyReportProxy"
      },
      {
        "source": "/alertbox",
        "destination": "/expo-app.html"
      },
      {
        "source": "/alertbox/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/daily_user_stats",
        "destination": "/expo-app.html"
      },
      {
        "source": "/daily_user_stats/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-comment",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-comment/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-postit",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-postit/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/_next/static/**",
        "destination": "/__gone__"
      },
      {
        "source": "/_expo/static/**",
        "destination": "/__gone__"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|mp4|webm|mp3)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_expo/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(alertbox|daily_user_stats|ve-comment|ve-postit)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/@(alertbox|daily_user_stats|ve-comment|ve-postit)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/expo-app*",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/*_monthly_review*",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/202601_donation_ceremony*",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/donut-progress",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/@(alert|donut-progress|monthly)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
