{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/island-api/**",
        "function": "islandApi"
      },
      {
        "source": "/nanitabeyo-weekly-report-proxy",
        "function": "nanitabeyoWeeklyReportProxy"
      },
      {
        "source": "/nanitabeyo-weekly-report-proxy/**",
        "function": "nanitabeyoWeeklyReportProxy"
      },
      {
        "source": "/alertbox",
        "destination": "/expo-app.html"
      },
      {
        "source": "/alertbox/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/chat-display",
        "destination": "/expo-app.html"
      },
      {
        "source": "/chat-display/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/credits",
        "destination": "/expo-app.html"
      },
      {
        "source": "/credits/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/daily_user_stats",
        "destination": "/expo-app.html"
      },
      {
        "source": "/daily_user_stats/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/nanitabeyo-dish-category-recommendation-progress",
        "destination": "/expo-app.html"
      },
      {
        "source": "/nanitabeyo-dish-category-recommendation-progress/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-comment",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-comment/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-postit",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-postit/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}