{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/nordic/photos",
        "destination": "/cards",
        "type": 301
      },
      {
        "source": "/nordic/photos/**",
        "destination": "/cards",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/island-api/**",
        "function": "islandApi"
      },
      {
        "source": "/nanitabeyo-weekly-report-proxy",
        "function": "nanitabeyoWeeklyReportProxy"
      },
      {
        "source": "/nanitabeyo-weekly-report-proxy/**",
        "function": "nanitabeyoWeeklyReportProxy"
      },
      {
        "source": "/alertbox",
        "destination": "/expo-app.html"
      },
      {
        "source": "/alertbox/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/daily_user_stats",
        "destination": "/expo-app.html"
      },
      {
        "source": "/daily_user_stats/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-comment",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-comment/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-postit",
        "destination": "/expo-app.html"
      },
      {
        "source": "/ve-postit/**",
        "destination": "/expo-app.html"
      },
      {
        "source": "/_next/static/**",
        "destination": "/__gone__"
      },
      {
        "source": "/_expo/static/**",
        "destination": "/__gone__"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|mp4|webm|mp3)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_expo/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
